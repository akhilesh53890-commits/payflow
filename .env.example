# ==============================================================================
# PayFlow Platform - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_NAME=payflow
APP_BASE_URL=http://localhost:8080

# Database (PostgreSQL - Financial Source of Truth)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payflow_db
DB_USER=payflow_user
DB_PASSWORD=payflow_secure_pass_change_me
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_CONNECTION_TIMEOUT_MS=20000

# Cache & Rate Limiter (Redis - Performance Optimization Only)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_TIMEOUT_MS=1000

# Messaging (Apache Kafka - Asynchronous Event Transport)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=payflow-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest

# Security & JWT Tokens
# HS256 secret key must be at least 256 bits (32+ bytes)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# Merchant API Key Security
# Pepper for hashing merchant API secret keys with HMAC-SHA256
API_KEY_PEPPER=d7a31b4e9f284c0cbb91a5823e59f42589e4726c518fb901763efc814032d917

# Outbox Publisher Configuration
OUTBOX_PUBLISH_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_RETRIES=5

# Webhook Delivery Engine
WEBHOOK_DELIVERY_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=4
WEBHOOK_BACKOFF_INITIAL_DELAY_MS=2000
WEBHOOK_BACKOFF_MULTIPLIER=2.0

# Management & Observability
MANAGEMENT_SERVER_PORT=8080
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus,env
PROMETHEUS_METRICS_EXPORT_ENABLED=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
PORT=3000

